{
  "name": "aurelune",
  "version": "1.0.0",
  "description": "Aurelune \u2014 a self-hosted music & podcast streaming platform with artist studio, synced lyrics and a listening API.",
  "author": "Alireza Asakareh (RealUnfazed) <https://github.com/RealUnfazed>",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js --force",
    "desktop": "electron .",
    "desktop:build": "node scripts/build-desktop.mjs",
    "test": "node test/run.mjs",
    "mock:postfile": "node scripts/mock-postfile.mjs",
    "desktop:client": "electron . --client",
    "desktop:build:full": "node scripts/build-desktop.mjs full",
    "desktop:build:client": "node scripts/build-desktop.mjs client"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "mongoose": "^9.10.1",
    "multer": "^2.4.0",
    "music-metadata": "^11.15.0"
  },
  "devDependencies": {
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1"
  }
}
