# Copy to .env for local use. On Vercel, set these in Project -> Settings -> Environment Variables
# (a .env file is NOT deployed). See README "Deploying to Vercel".

# ---- Database ---------------------------------------------------------------
# REQUIRED on Vercel (use MongoDB Atlas; allow 0.0.0.0/0 in Network Access, since Vercel IPs change).
# Locally, a mongod on the default port works as-is.
MONGODB_URI=mongodb://127.0.0.1:27017/aurelune

# ---- Server -----------------------------------------------------------------
# Local/self-hosted/Electron only. Ignored on Vercel (it provides the port itself).
PORT=3000
# Set to "production" on any public deployment (Vercel sets this for you).
# NODE_ENV=production

# ---- Admin account ----------------------------------------------------------
ADMIN_EMAIL=admin@aurelune.local
# REQUIRED in production (>= 8 chars). In production no default-password admin is created
# and the first signup does NOT become admin.
# ADMIN_PASSWORD=

# ---- Upload storage (two options; users pick per upload) --------------------
# Option 1: "local"   - encrypted files on this server's disk. Self-hosted/Electron only;
#                       unavailable on Vercel (read-only, ephemeral filesystem).
# Option 2: "postfile" - files stored on https://postfile.net. Works everywhere, including Vercel.
# POSTFILE_API_KEY=
# Several PostFile accounts: uploads rotate over them and fail over when one is out of quota / rate-limited.
# POSTFILE_API_KEYS=key1,key2,key3
# Force a default when both are available: local | postfile
# STORAGE_DRIVER=local
# Per-file cap in MB (PostFile free plan: 50).
# POSTFILE_MAX_MB=50
# Files bigger than this many MB (kept under the cap above) are split into parts and played back as one.
# POSTFILE_PART_MB=40
# auto: play PostFile audio from its CDN when the equalizer can process it, else via this server. always: always via this server.
# STREAM_PROXY=auto
# Only if PostFile gives you a different API host.
# POSTFILE_API_BASE=https://postfile.net

# ---- Local storage options (ignored on Vercel) ------------------------------
# Pin the AES key (any long random string) so it survives moving servers. Otherwise one is
# generated in DATA_DIR/.audio-key - back it up.
# AUDIO_ENCRYPTION_KEY=
# Secret that offline-download licence keys are derived from (any long random string). Falls back to AUDIO_ENCRYPTION_KEY; on Vercel a
# stable one is derived from your other settings when neither is set. Changing it makes every device's downloads stop opening until they check in.
# DOWNLOAD_LICENSE_SECRET=
# DATA_DIR=./data
# MAX_AUDIO_MB=600
# MAX_IMAGE_MB=8

# ---- Creator pages ----------------------------------------------------------
# How many creator pages a new account may have (default 1). Admins can change this for any user
# (a set number, or unlimited) from Admin > Users.
# DEFAULT_CREATOR_PAGES=1

# ---- Demo content -----------------------------------------------------------
# Seeds sample artists/tracks into an empty database. Default: on locally, OFF on Vercel.
# SEED_DEMO=true
