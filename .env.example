# Copy this file to .env and adjust as needed. Every value has a sensible
# default (see server/config.js) — you only need to set what you want to change.

# Where MongoDB lives. A local mongod on the default port needs no changes.
MONGODB_URI=mongodb://127.0.0.1:27017/aurelune

# HTTP port the server listens on.
PORT=3000

# Where uploaded audio/images and the SQLite-free Mongo data live on disk
# (only affects file uploads — MongoDB stores its own data via MONGODB_URI).
DATA_DIR=./data

# First-run behavior: if the database is empty, seed a synthesized demo
# catalog (fake, royalty-free audio) so the app isn't blank. Set to false
# for a real deployment.
SEED_DEMO=true

# Created automatically as an admin account the first time the app starts
# with an empty user table. CHANGE THE PASSWORD immediately after first login.
ADMIN_EMAIL=admin@aurelune.local
ADMIN_PASSWORD=change-me-immediately

# Upload size limits, in megabytes.
MAX_AUDIO_MB=200
MAX_IMAGE_MB=8

# Set to "production" to enable secure (HTTPS-only) cookies. Leave unset for
# local development over plain HTTP.
NODE_ENV=development
