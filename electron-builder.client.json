{
  "appId": "app.aurelune.desktop",
  "productName": "Aurelune",
  "directories": {
    "buildResources": "build",
    "output": "dist-electron/client"
  },
  "icon": "build/icon.png",
  "mac": {
    "category": "public.app-category.music",
    "target": "dmg",
    "icon": "build/icon.png"
  },
  "linux": {
    "category": "Audio",
    "target": [
      "AppImage",
      "deb"
    ],
    "icon": "build/icon.png",
    "maintainer": "Alireza Asakareh (RealUnfazed)"
  },
  "win": {
    "target": "nsis",
    "icon": "build/icon.ico"
  },
  "artifactName": "${productName}-${version}-client-${os}-${arch}.${ext}",
  "files": [
    "electron/**/*",
    "package.json",
    "!**/node_modules/**"
  ]
}
